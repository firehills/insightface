{
  "name": "InsightFace (CPU)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "INSIGHTFACE_DATA_DIR": "/home/vscode/.insightface/server-data",
    "INSIGHTFACE_MODELS_DIR": "/home/vscode/.insightface/server-models"
  },
  "mounts": [
    "source=${devcontainerId}-insightface-cache,target=/home/vscode/.insightface,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "InsightFace Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/insightface-venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.testing.cwd": "${workspaceFolder}/python-package"
      }
    }
  }
}